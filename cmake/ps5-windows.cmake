if(NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "Only a native Windows host is supported.")
endif()
foreach(required LLVM_ROOT PS5_SDK_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required.")
    endif()
endforeach()
file(TO_CMAKE_PATH "${LLVM_ROOT}" LLVM_ROOT)
file(TO_CMAKE_PATH "${PS5_SDK_ROOT}" PS5_SDK_ROOT)

set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(PS5 TRUE)
set(PROSPERO TRUE)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_SKIP_RPATH TRUE CACHE BOOL "" FORCE)
set(CMAKE_NINJA_FORCE_RESPONSE_FILE ON CACHE BOOL "" FORCE)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
set(CMAKE_C_COMPILER "${LLVM_ROOT}/bin/clang.exe")
set(CMAKE_CXX_COMPILER "${LLVM_ROOT}/bin/clang++.exe")
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_AR "${LLVM_ROOT}/bin/llvm-ar.exe")
set(CMAKE_RANLIB "${LLVM_ROOT}/bin/llvm-ranlib.exe")
set(CMAKE_LINKER "${LLVM_ROOT}/bin/ld.lld.exe")
set(CMAKE_SYSROOT "${PS5_SDK_ROOT}")
set(CMAKE_FIND_ROOT_PATH "${PS5_SDK_ROOT}/target")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES LLVM_ROOT PS5_SDK_ROOT)

set(common "-fvisibility-nodllstorageclass=default -isystem \"${PS5_SDK_ROOT}/target/include\" -fno-stack-protector -fno-plt -femulated-tls")
set(CMAKE_C_FLAGS_INIT "${common}")
set(CMAKE_CXX_FLAGS_INIT "-nostdinc++ -isystem \"${PS5_SDK_ROOT}/target/include/c++/v1\" ${common} -fno-exceptions -fno-rtti")
# Native applications use the boilerplate CRT, not the SDK's payload crt1.o.
set(CMAKE_CXX_LINK_EXECUTABLE "<CMAKE_LINKER> -m elf_x86_64 -pie --eh-frame-hdr -z max-page-size=0x4000 -mllvm -emulated-tls --hash-style=gnu <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
set(CMAKE_C_LINK_EXECUTABLE "<CMAKE_LINKER> -m elf_x86_64 -pie <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
set(CMAKE_POLICY_DEFAULT_CMP0075 NEW)
