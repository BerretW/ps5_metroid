{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build PROJECT ECHO (Debug)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-windows.ps1",
        "-Configuration",
        "Debug"
      ],
      "problemMatcher": ["$msCompile"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Test PROJECT ECHO",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-windows.ps1",
        "-Configuration",
        "Debug",
        "-RunTests"
      ],
      "problemMatcher": ["$msCompile"]
    }
  ]
}
